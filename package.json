{
  "name": "navigator-mcp",
  "version": "1.0.1",
  "description": "MCP server with a real browser for search, extraction, and screenshots",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/mcp-server.js",
  "files": [
    "src",
    "docker",
    "scripts",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftpip/navigator.git"
  },
  "homepage": "https://github.com/craftpip/navigator#readme",
  "bugs": {
    "url": "https://github.com/craftpip/navigator/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "search",
    "chromium",
    "puppeteer",
    "http-server"
  ],
  "scripts": {
    "start": "node src/mcp-server.js",
    "bench": "node benchmark/web-search-benchmark.mjs",
    "test:hints": "vitest run tests/domain-hints.test.js",
    "test:hints:live": "LIVE_DOMAIN_HINTS=1 vitest run tests/domain-hints-live.test.js",
    "docs": "typedoc src/ --out doc",
    "lint": "eslint src/ scripts/ tests/",
    "lint:fix": "eslint --fix src/ scripts/ tests/",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typedoc": "^0.28.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "cloakbrowser": "^0.5.4",
    "jsdom": "^27.0.0",
    "puppeteer-core": "^24.21.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
